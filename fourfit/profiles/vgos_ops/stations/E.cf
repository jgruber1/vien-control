* station E
*==========================================================

if station E
  pc_tonemask def  16 16 17

*For ST and WV baseline only, differential TEC should be zero
*absolute TEC does not make any difference, so set both stations' ionosphere to zero

if station E
  sampler_delay_x -55 -50 -55 -55
  sampler_delay_y -55 -50 -50 -55

if station E
  pc_phases_x abcdefghijklmnopqrstuvwxyzABCDEF  -1.4  -4.7  -4.2  -6.1  1.7  2.0  5.1  -2.9  9.3  9.0  6.0  7.8  12.0  14.4  19.7  19.3  -14.8  -25.3  -20.6  -20.7  -16.2  -13.5  -4.5  -2.2  -1.8  -2.7  -2.2  -5.1  1.3  7.2  14.6  16.9
  pc_phases_y abcdefghijklmnopqrstuvwxyzABCDEF  -1.0  -6.5  -0.9  4.9  8.4  -2.0  -7.4  29.2  -7.2  13.0  5.5  6.9  10.0  19.6  21.6  23.6  -21.5  -32.3  -27.7  -16.9  -6.6  -9.5  -0.4  -2.5  0.5  -1.7  -7.7  -4.3  -2.0  10.1  30.3  3.4

